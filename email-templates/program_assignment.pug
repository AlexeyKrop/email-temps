extends layouts/base
include ./mixins/index.pug
block content
  include layouts/header
  tr
    td(style="height: auto; background-color: #ffffff; padding: 40px 40px 64px; vertical-align: top;")
      +mainTitle("You're part of a new program")
      p(style="margin: 0;font-size: 20px; line-height: 30px; margin-bottom: 40px;") #{companyName} is now a part of #{programName}
      +button(programLink, "Program")
  include layouts/footer